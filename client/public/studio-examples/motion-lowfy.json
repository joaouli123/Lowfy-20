ht=\"20\" fill=\"#10b981\"/>\n          <circle cx=\"200\" cy=\"230\" r=\"172\" fill=\"#111a2e\" stroke=\"#1e293b\" stroke-width=\"6\"/>\n          <circle cx=\"200\" cy=\"230\" r=\"150\" fill=\"none\" stroke=\"#1e293b\" stroke-width=\"24\"/>\n          <circle id=\"swRing\" cx=\"200\" cy=\"230\" r=\"150\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"24\" stroke-linecap=\"round\" stroke-dasharray=\"942.5\" stroke-dashoffset=\"942.5\" transform=\"rotate(-90 200 230)\"/>\n          <g id=\"swHand\"><line x1=\"200\" y1=\"230\" x2=\"200\" y2=\"105\" stroke=\"#fff\" stroke-width=\"6\" stroke-linecap=\"round\" opacity=\".5\"/></g>\n        </svg>\n        <div id=\"swPct\" class=\"abs anton\" style=\"left:0;width:400px;top:178px;text-align:center;font-size:110px;color:#fff\">0%</div>\n      </div>\n      <div id=\"swBurst\" class=\"abs\" style=\"left:340px;top:450px;width:400px;height:400px;border-radius:50%;border:10px solid #10b981;opacity:0\"></div>\n      <div id=\"ad\" class=\"adcard\">\n        <div id=\"adH\" class=\"abs\" style=\"left:24px;top:22px;width:512px;height:70px\">\n          <div class=\"abs\" style=\"left:0;top:0;width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,#10b981,#0f172a)\"></div>\n          <div class=\"bar2\" style=\"left:90px;top:12px;width:200px;background:#0f172a\"></div>\n          <div class=\"bar2\" style=\"left:90px;top:42px;width:130px;height:14px\"></div>\n        </div>\n        <div id=\"adI\" class=\"abs\" style=\"left:20px;top:110px;width:520px;height:260px;border-radius:22px;background:linear-gradient(135deg,#0f172a,#065f46 60%,#10b981);overflow:hidden\">\n          <div class=\"abs anton\" style=\"left:30px;top:40px;font-size:110px;color:#fff\">OFERTA</div>\n          <div class=\"abs\" style=\"left:34px;top:175px;padding:0 22px;height:56px;border-radius:30px;background:#10b981;color:#0f172a;font-weight:900;font-size:34px;line-height:56px\">-50% HOJE</div>\n          <div id=\"adShine\" class=\"abs\" style=\"top:-40px;width:80px;height:340px;background:rgba(255,255,255,.25);transform:rotate(20deg)\"></div>\n          <div class=\"abs\" style=\"right:30px;top:40px;width:150px;height:180px;border-radius:20px;background:rgba(255,255,255,.12);border:3px solid rgba(255,255,255,.35);font-size:90px;line-height:180px;text-align:center\">📦</div>\n        </div>\n        <div id=\"adC\" class=\"abs\" style=\"left:24px;top:392px;width:512px;height:80px\">\n          <div class=\"bar2\" style=\"left:0;top:0;width:480px\"></div>\n          <div class=\"bar2\" style=\"left:0;top:30px;width:400px\"></div>\n          <div class=\"bar2\" style=\"left:0;top:60px;width:300px\"></div>\n        </div>\n        <div id=\"adB\" class=\"abs\" style=\"left:24px;top:490px;width:512px;height:60px;border-radius:16px;background:#10b981;color:#0f172a;font-weight:900;font-size:32px;line-height:60px;text-align:center\">COMPRAR AGORA</div>\n        <div id=\"adStamp\" class=\"abs\" style=\"left:300px;top:20px;width:230px;height:76px;border-radius:14px;border:5px solid #10b981;color:#10b981;font-weight:900;font-size:40px;line-height:66px;text-align:center;background:#f0fdf4\">✓ PRONTO</div>\n      </div>\n      <div id=\"chart\" class=\"abs\" style=\"left:600px;top:1050px;width:420px;height:330px;border-radius:30px;background:#111c33;border:3px solid #10b981;box-shadow:0 0 60px rgba(16,185,129,.35)\">\n        <div class=\"abs\" style=\"left:28px;top:22px;font-weight:800;font-size:30px;color:#94a3b8\">Conversão</div>\n        <div id=\"chVal\" class=\"abs anton\" style=\"left:26px;top:58px;font-size:78px;color:#10b981\">+0%</div>\n        <svg class=\"abs\" style=\"left:30px;top:140px\" width=\"360\" height=\"170\" viewBox=\"0 0 360 170\">\n          <defs>\n            <linearGradient id=\"ag\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#10b981\" stop-opacity=\".5\"/><stop offset=\"1\" stop-color=\"#10b981\" stop-opacity=\"0\"/></linearGradient>\n            <clipPath id=\"chClip\"><rect id=\"chRect\" x=\"0\" y=\"0\" width=\"0\" height=\"170\"/></clipPath>\n          </defs>\n          <g clip-path=\"url(#chClip)\">\n            <path d=\"M5 160 C 60 155, 90 140, 120 128 S 180 110, 210 86 S 290 50, 352 12 L352 170 L5 170 Z\" fill=\"url(#ag)\"/>\n            <path id=\"chLine\" d=\"M5 160 C 60 155, 90 140, 120 128 S 180 110, 210 86 S 290 50, 352 12\" fill=\"none\" stroke=\"#10b981\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n          </g>\n          <circle id=\"chDot\" cx=\"5\" cy=\"160\" r=\"11\" fill=\"#fff\" stroke=\"#10b981\" stroke-width=\"5\"/>\n        </svg>\n      </div>\n    </section>\n\n    <!-- CENA 5 -->\n    <section class=\"scene\" id=\"s5\">\n      <div id=\"s5a\" class=\"abs ctr anton\" style=\"top:150px;font-size:220px;color:#fff\"></div>\n      <div id=\"s5b\" class=\"abs ctr\" style=\"top:390px;height:200px\">\n        <div class=\"abs ctr anton\" style=\"top:0;font-size:170px;color:#10b981;text-shadow:0 0 40px rgba(16,185,129,.5)\">PERDER TEMPO</div>\n        <div id=\"s5strike\" class=\"abs\" style=\"left:90px;top:88px;height:22px;width:0;border-radius:12px;background:#ff3b5c;box-shadow:0 0 24px #ff3b5c\"></div>\n      </div>\n      <div id=\"s5lbl\" class=\"abs ctr\" style=\"top:680px;font-weight:900;font-size:58px;letter-spacing:6px;color:#d1fae5\">👇 ACESSE AGORA</div>\n      <div id=\"ring1\" class=\"ring\"></div>\n      <div id=\"ring2\" class=\"ring\"></div>\n      <div id=\"btn\" class=\"btn\"><span class=\"anton\" style=\"font-size:112px;line-height:210px;color:#0f172a;letter-spacing:3px\">TESTE O LOWFY ➜</span></div>\n      <div id=\"burst\" class=\"abs\" style=\"left:640px;top:925px;width:0;height:0\"></div>\n      <div id=\"ripple\" class=\"abs\" style=\"left:540px;top:825px;width:200px;height:200px;border-radius:50%;border:8px solid #fff;opacity:0\"></div>\n      <div id=\"wipe\" class=\"abs\" style=\"left:540px;top:825px;width:200px;height:200px;border-radius:50%;background:#10b981;transform:scale(0)\"></div>\n      <div id=\"final\" class=\"abs\" style=\"inset:0;opacity:0\">\n        <div id=\"fIc\" class=\"abs\" style=\"left:430px;top:330px;width:220px;height:220px\">\n          <svg width=\"220\" height=\"220\" viewBox=\"0 0 100 100\">\n            <rect x=\"4\" y=\"4\" width=\"92\" height=\"92\" rx=\"26\" fill=\"#0f172a\"/>\n            <path d=\"M58 12 L24 56 H46 L40 90 L78 42 H55 Z\" fill=\"#10b981\"/>\n          </svg>\n        </div>\n        <div id=\"fWord\" class=\"abs ctr\" style=\"top:580px;font-weight:900;font-size:240px;letter-spacing:-8px;line-height:1;color:#0f172a\">Lowfy</div>\n        <div id=\"fBtn\" class=\"abs\" style=\"left:110px;top:900px;width:860px;height:190px;border-radius:100px;background:#0f172a;text-align:center;box-shadow:0 24px 60px rgba(2,6,23,.45)\"><span class=\"anton\" style=\"font-size:100px;line-height:190px;color:#10b981\">TESTE AGORA ➜</span></div>\n        <div id=\"fTag\" class=\"abs ctr\" style=\"top:1150px;font-weight:900;font-size:56px;color:#0f172a;letter-spacing:6px\">⚡ AGORA MESMO!</div>\n      </div>\n      <div id=\"cursor\" class=\"abs\" style=\"left:0;top:0;width:110px;height:140px;transform-origin:0 0\">\n        <svg width=\"110\" height=\"140\" viewBox=\"-4 -4 74 104\"><path d=\"M0 0 L0 80 L20 62 L36 96 L52 89 L36 56 L64 56 Z\" fill=\"#fff\" stroke=\"#0f172a\" stroke-width=\"5\" stroke-linejoin=\"round\"/></svg>\n      </div>\n    </section>\n  </div>\n\n  <div id=\"glitch\"></div>\n  <div id=\"flash\"></div>\n  <div id=\"vig\"></div>\n</div>\n\n<script>\n(function(){\nconst M = window.MOTION || {};\nlet T = [[0,3.4],[3.4,7.88],[7.88,14.08],[14.08,18.7],[18.7,23.34]];\nif (M.scenes && M.scenes.length >= 5) T = M.scenes.slice(0,5).map(s=>[s.start,s.end]);\nconst DUR = M.duration || T[4][1];\n\nconst $ = id => document.getElementById(id);\nconst clamp=(x,a=0,b=1)=>Math.min(b,Math.max(a,x));\nconst lin=(t,a,b)=>clamp((t-a)/(b-a));\nconst eOC=p=>1-Math.pow(1-p,3);\nconst eIC=p=>p*p*p;\nconst eIO=p=>p<.5?4*p*p*p:1-Math.pow(-2*p+2,3)/2;\nconst eOB=p=>{const c1=2.2,c3=c1+1;return p<=0?0:1+c3*Math.pow(p-1,3)+c1*Math.pow(p-1,2);};\nconst hash=n=>{const x=Math.sin(n*127.1+311.7)*43758.5453;return x-Math.floor(x);};\nconst S=(el,o)=>{for(const k in o) el.style[k]=o[k];};\n\n// ---------- build ----------\nfunction letters(el,txt){el.innerHTML='';[...txt].forEach(c=>{const s=document.createElement('span');s.className='ch';s.textContent=c===' '?'\\u00A0':c;el.appendChild(s);});return [...el.children];}\nconst L1a=letters($('s1a'),'HORAS');\nconst L1b=letters($('s1b'),'PERDIDAS?');\nconst L5a=letters($('s5a'),'PARE DE');\n// Lowfy wordmark\nconst wm=$('s2word'); wm.innerHTML='';\nconst LW=[];\n[...'Lowfy'].forEach((c,i)=>{const s=document.createElement('span');s.className='ch';s.textContent=c;s.style.color=i>=3?'#10b981':'#fff';if(i>=3)s.style.textShadow='0 0 40px rgba(16,185,129,.7)';wm.appendChild(s);LW.push(s);});\n\n// dust\nconst dust=[];\nfor(let i=0;i<34;i++){const d=document.createElement('div');d.className='dust';const sz=3+hash(i*3.1)*7;S(d,{width:sz+'px',height:sz+'px'});$('dustBox').appendChild(d);dust.push({el:d,x:hash(i*7.7)*1080,y:hash(i*5.3)*1920,sp:20+hash(i*2.2)*70,ph:hash(i)*6.28});}\n\n// clock ticks\nlet tk='';for(let i=0;i<12;i++){const a=i*30;tk+=`<line x1=\"200\" y1=\"${i%3?44:38}\" x2=\"200\" y2=\"62\" stroke=\"${i%3?'#64748b':'#fff'}\" stroke-width=\"${i%3?5:9}\" stroke-linecap=\"round\" transform=\"rotate(${a} 200 200)\"/>`;}\n$('ticks').innerHTML=tk;\nlet tr='';for(let i=0;i<5;i++){tr+=`<g class=\"trail\"><line x1=\"200\" y1=\"200\" x2=\"200\" y2=\"62\" stroke=\"#10b981\" stroke-width=\"10\" stroke-linecap=\"round\" opacity=\"${0.35-i*0.06}\"/></g>`;}\n$('trails').innerHTML=tr;\nconst trails=[...document.querySelectorAll('#trails .trail')];\n\n// timeline\nfunction tlHTML(){\n  let h='<div class=\"tlpanel\">';\n  for(let i=0;i<30;i++) h+=`<div class=\"tick\" style=\"left:${20+i*31}px;height:${i%5?10:18}px\"></div>`;\n  const cols=['#10b981','#22d3ee','#a78bfa','#f59e0b','#ff3b5c','#34d399'];\n  let n=0;\n  for(let r=0;r<3;r++){\n    let x=14;\n    while(x<920){const w=36+Math.floor(hash(n*9.1+r)*110);const c=cols[Math.floor(hash(n*4.7+r*3)*cols.length)];\n      h+=`<div class=\"clip\" style=\"left:${x}px;top:${42+r*60}px;width:${w}px;background:${c};opacity:.85\"></div>`;\n      x+=w-Math.floor(hash(n*2.3)*18); n++;}\n  }\n  h+='<div class=\"ph\"></div></div>';return h;\n}\n$('tlL').innerHTML=tlHTML();$('tlR').innerHTML=tlHTML();\nconst phs=[...document.querySelectorAll('#tl .ph')];\n\n// particles scene 2\nconst pts=[];\nfor(let i=0;i<44;i++){const d=document.createElement('div');d.className='pt';const sz=5+hash(i*1.7)*16;const col=['#10b981','#6ee7b7','#ffffff','#22d3ee'][i%4];\n  S(d,{width:sz+'px',height:sz+'px',background:col,boxShadow:`0 0 ${sz*1.6}px ${col}`});$('ptBox').appendChild(d);\n  pts.push({el:d,a0:hash(i*3.3)*6.283,r:210+hash(i*8.1)*300,sp:(0.3+hash(i*4.4)*0.9)*(i%2?1:-1),sz,del:hash(i*6.6)*0.5,tw:hash(i*9.9)*6.28});}\n\n// cards\nconst cardData=[['✍️','Copywriting'],['🎨','Design'],['🎙️','Locução IA'],['🎬','Motion Video']];\nconst cards=[];\ncardData.forEach((c,i)=>{const d=document.createElement('div');d.className='card';\n  const x=i%2?560:80, y=i<2?560:1015;S(d,{left:x+'px',top:y+'px'});\n  d.innerHTML=`<div class=\"ic\">${c[0]}</div><div class=\"lb\">${c[1]}</div><div class=\"bar\"><div class=\"fill\"></div></div>`;\n  $('cards').appendChild(d);cards.push({el:d,ic:d.querySelector('.ic'),fill:d.querySelector('.fill')});});\n\n// burst rays scene 5\nconst rays=[];\nfor(let i=0;i<18;i++){const d=document.createElement('div');S(d,{position:'absolute',left:'0',top:'-6px',width:'90px',height:'12px',borderRadius:'6px',background:i%2?'#fff':'#10b981',transformOrigin:'0 6px',opacity:0});$('burst').appendChild(d);rays.push(d);}\n\n// glitch slices\nconst slices=[];\nfor(let i=0;i<16;i++){const d=document.createElement('div');d.className='slice';const h=20+hash(i*5.5)*140;S(d,{top:(hash(i*3.9)*1880)+'px',height:h+'px',background:['#10b981','#ff2d55','#22d3ee','#ffffff'][i%4]});$('glitch').appendChild(d);slices.push({el:d,h});}\n\nconst chLine=$('chLine');let chLen=400;try{chLen=chLine.getTotalLength();}catch(e){}\n\n// ---------- timing helpers ----------\nconst sc=[$('s1'),$('s2'),$('s3'),$('s4'),$('s5')];\nconst s0=T.map(x=>x[0]);\nconst impulses=[\n [s0[0]+0.15,12],[s0[0]+0.55,18],[s0[0]+2.2,34],\n [s0[1]+0.0,22],[s0[1]+0.4,24],[s0[1]+2.2,26],\n [s0[2]+0.45,16],[s0[2]+1.6,12],[s0[2]+2.5,12],[s0[2]+3.4,12],[s0[2]+4.3,14],\n [s0[3]+0.2,16],[s0[3]+2.3,24],\n [s0[4]+0.05,16],[s0[4]+0.35,20],[s0[4]+2.75,36]\n];\nconst glitchBumps=[[s0[1],0.38,1],[s0[1]+2.0,0.25,0.8],[s0[2],0.18,0.45],[s0[3],0.18,0.45],[s0[4],0.18,0.45]];\nconst flashes=[[s0[0]+0.55,.35],[s0[0]+2.2,.55],[s0[1]+0.4,.45],[s0[1]+2.2,.6],[s0[3]+2.3,.4],[s0[4]+2.75,.7]];\n\nfunction bump(t,c,w){const d=Math.abs(t-c);return d>w?0:1-d/w;}\n\nfunction letterAnim(arr,lt,t0,st,t,dir){\n  arr.forEach((s,k)=>{const p=lin(lt,t0+k*st,t0+k*st+0.42);const e=eOB(p);\n    const y=(1-e)*(dir||-260)+(p>=1?Math.sin(t*5+k*0.9)*5:0);\n    const scl=1+(1-e)*1.3;const rot=(1-e)*(k%2?24:-24);\n    S(s,{transform:`translateY(${y}px) scale(${scl}) rotate(${rot}deg)`,opacity:clamp(p*4)});});\n}\n\n// ---------- render ----------\nwindow.renderFrame=function(t){\n  t=Math.max(0,Math.min(t,DUR));\n\n  // background\n  S($('grid'),{transform:`translateY(${(t*50)%60}px)`});\n  const gx=540+Math.sin(t*0.6)*180-700, gy=760+Math.cos(t*0.45)*220-700;\n  S($('glowA'),{left:gx+'px',top:gy+'px',transform:`scale(${1+0.08*Math.sin(t*2.1)})`});\n  const redA=t<s0[1]?(0.6+0.4*Math.sin(t*9))*clamp(1-lin(t,s0[1]-0.4,s0[1])):0;\n  S($('glowR'),{left:(540-700+Math.cos(t)*120)+'px',top:(820-700)+'px',opacity:redA});\n  $('glowA').style.opacity=t<s0[1]?0.35:1;\n  dust.forEach((d,i)=>{let y=((d.y-t*d.sp)%1920+1920)%1920;const x=d.x+Math.sin(t*0.9+d.ph)*30;\n    S(d.el,{transform:`translate(${x}px,${y}px)`,opacity:0.25+0.35*Math.sin(t*2+d.ph)